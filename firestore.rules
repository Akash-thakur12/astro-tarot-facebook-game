rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profile Lockdown
    match /users/{userId} {
      // Allow users to read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Hardened Create Rule: Force default economy values
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.coins == 100
        && request.resource.data.premium == false
        && request.resource.data.streak == 1
        && request.resource.data.adsWatchedToday == 0;
      
      // Hardened Update Rule: Only allow specific non-sensitive fields
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'photoURL', 'currentLanguage', 'lastActive']);
            
      // NOTE: Any attempt to update coins, xp, premium, or daily flags 
      // from the client will now return PERMISSION_DENIED.
    }

    // Tarot History Lockdown
    match /users/{userId}/tarotHistory/{docId} {
      // Users can view their own history
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Strictly block all client-side writes (handled by /api/tarot/save-reading)
      allow write: if false;
    }
    
    // Default: Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
