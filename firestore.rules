rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profile Lockdown
    match /users/{userId} {
      // Allow users to read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Hardened Create Rule: Force default economy values
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.coins == 100
        && request.resource.data.premium == false
        && request.resource.data.streak == 1
        && request.resource.data.adsWatchedToday == 0;
      
      // Hardened Update Rule: Strictly limit allowed fields
      // Clients are FORBIDDEN from modifying: premium, subscriptionExpiry, lastPurchaseDate, coins, xp, usage flags, and timestamps
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['premium', 'subscriptionExpiry', 'lastPurchaseDate', 'coins', 'xp', 'dailyChallengesClaimed', 'dailyQuestionUsed', 'dailyTarotUsed', 'dailySpinUsed', 'lastQuestionDate', 'lastTarotReadingDate', 'lastSpinDate'])
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'photoURL', 'currentLanguage', 'lastActive']);
    }

    // Premium Purchases Lockdown (Server-Authoritative Only)
    match /premiumPurchases/{purchaseId} {
      // Users can only read their own purchase records
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      
      // Strictly block all client-side writes
      allow write: if false;
    }

    // Tarot History Lockdown
    match /users/{userId}/tarotHistory/{docId} {
      // Users can view their own history
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Strictly block all client-side writes (handled by /api/tarot/save-reading)
      allow write: if false;
    }

    // Pandit History Subcollection
    match /users/{userId}/panditHistory/{messageId} {
      // User may read own messages
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      // User may create new messages
      allow create: if request.auth != null
                    && request.auth.uid == userId;

      // Prevent editing or deleting history
      allow update, delete: if false;
    }
    
    // Default: Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
